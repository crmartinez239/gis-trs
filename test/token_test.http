### GET request with parameter
@devBaseURL = http://localhost:3000

@tokenEndpoint = /token
@storeEndpoint = /store

# Be sure to set this to the same key in the env file
@apiKey = testkeytestkey123

@testUserID = testUser123456789
@testAccessToken = testAccessToken123456789
@testRefreshToken = testRefreshToken123456789
@testExpiresIn = 1

### Valid request with api key and test user id - 200
GET {{devBaseURL}}{{tokenEndpoint}}/{{testUserID}}
Accept: application/json
gis-api-key: {{apiKey}}

### Unauthorized request (no api key in header) - 401
GET {{devBaseURL}}{{tokenEndpoint}}/{{testUserID}}
Accept: application/json

### Request with api key but no good user id - 404
GET {{devBaseURL}}{{tokenEndpoint}}/baduserid12345678
Accept: application/json
gis-api-key: {{apiKey}}


### Valid post with api key and valid payload - 200
POST {{devBaseURL}}{{storeEndpoint}}
Content-Type: application/json
gis-api-key: {{apiKey}}

{
  "user_id": "{{testUserID}}",
  "access_token": "{{testAccessToken}}",
  "refresh_token": "{{testRefreshToken}}",
  "expires_in": {{testExpiresIn}}
}
